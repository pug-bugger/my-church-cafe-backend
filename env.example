PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=church_cafe_db

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Network receipt printer (MUNBYN ITPP047P, WiFi) — raw TCP/IP printing.
# PRINTER_HOST = the printer's IP address (give it a static IP / DHCP
# reservation so it doesn't change). Leave unset to disable printing.
PRINTER_HOST=
PRINTER_PORT=9100

# CORS allowed origins for both REST + Socket.IO
# - unset or "*" means allow any origin (dev-friendly)
# - set to one origin: CORS_ORIGIN=http://localhost:3000
# - set multiple: CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000

# Max size (MB) for product + user image uploads (multer). Default 15, max 50.
# If you still get 413 before Node sees the request, raise your reverse proxy limit, e.g. nginx:
#   client_max_body_size 20M;
UPLOAD_MAX_IMAGE_MB=15


# Push notifications go out through the Expo Push Service (order ready /
# cancelled). No setting is needed for that. Set this only if "enhanced push
# security" is turned on for the mobile app's EAS project; create the token at
# expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=

# Sign in with Google. The OAuth 2.0 *Web application* client id from Google
# Cloud Console → APIs & Services → Credentials (add your site's origin under
# "Authorized JavaScript origins"). Comma-separate several ids to also accept
# tokens from the iOS/Android clients. Leave empty to hide the Google button.
# Also run scripts/migration_google_accounts.sql.
GOOGLE_CLIENT_ID=
